# Escape Hatch Configuration

# The EOA address you want to escape ETH from on L2
ESCAPE_ADDRESS=0xdd

# L1 RPC endpoint (Ethereum mainnet)
L1_RPC_URL=https://ethereum-rpc.publicnode.com

# L2 RPC endpoint (Zircuit mainnet)
L2_RPC_URL=http://localhost:8545  

# L2OutputOracle contract address on L1
L2_OUTPUT_ORACLE_ADDRESS=0x92Ef6Af472b39F1b363da45E35530c24619245A4

# OptimismPortal contract address on L1  
OPTIMISM_PORTAL_ADDRESS=0x17bfAfA932d2e23Bd9B909Fd5B4D2e2a27043fb1

# ERC20 Escape Configuration (only needed for ERC20 escaping)
# L1StandardBridge contract address on L1
L1_STANDARD_BRIDGE_ADDRESS=0x386B76D9cA5F5Fb150B6BFB35CF5379B22B26dd8

# L1 ERC20 token address
L1_ERC20_ADDRESS=0x1234567890123456789012345678901234567890

# L2 ERC20 token address  
L2_ERC20_ADDRESS=0x1234567890123456789012345678901234567890 

# L2 ERC20 token Upgradable
ERC20_UPGRADABLE=false
